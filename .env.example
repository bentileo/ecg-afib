# Copy to .env on the server and fill in. Never commit the real .env.
#
# The application runs without any of these; Supabase simply stays disabled and
# the history view does not appear.

# --- Supabase ---------------------------------------------------------------
# Project URL, from Settings -> General in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key. Embedded in the application, so assume it is public.
# Row-level security grants it INSERT on the predictions table and nothing else.
SUPABASE_KEY=sb_publishable_your_key_here

# Secret key. Reads results back for the history view. Streamlit runs on the
# server rather than in the browser, so this never reaches a client. It bypasses
# row-level security entirely — keep it out of version control.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

SUPABASE_TABLE=predictions

# --- Admin ------------------------------------------------------------------
# Gates the history view. Without it the tab does not appear at all.
# Generate a long random value; there is no rate limiting on attempts.
ADMIN_PASSWORD=generate-a-long-random-password
